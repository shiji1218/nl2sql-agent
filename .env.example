# ===== 数据库 =====
# 默认用 SQLite（零配置，立即可跑）；切换 MySQL 见 README
# DATABASE_URL=mysql+pymysql://nl2sql:nl2sql123@127.0.0.1:3306/nl2sql_demo?charset=utf8mb4
DATABASE_URL=sqlite:///./nl2sql_demo.db

# ===== 大模型（阿里百炼 OpenAI 兼容模式）=====
BAILIAN_API_KEY=sk-xxxx替换成你的key
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 可选: qwen-plus / qwen-max / qwen3.7-plus / deepseek-v3-aliyun
LLM_MODEL=qwen-plus

# ===== Agent 行为 =====
# 查询结果最多返回行数（强制注入 LIMIT 的上限）
MAX_ROWS=50
# SQL 执行报错后自纠错的最大重试次数
MAX_REPAIR_ATTEMPTS=3
